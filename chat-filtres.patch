+from PySide6.QtCore import QSettings, Signal
+from PySide6.QtWidgets import (
+    QCheckBox,
+    QHBoxLayout,
+    QLabel,
+    QLineEdit,
+    QPushButton,
+    QTextBrowser,
+    QVBoxLayout,
+    QWidget,
+)
+
+# Chat messages between people are always shown; the other lines have a level.
+CHAT = "chat"
+DEBUG = "debug"
+INFO = "info"
+WARNING = "warning"
+ERROR = "error"
+
+LEVELS: tuple[tuple[str, str], ...] = (
+    (DEBUG, "Debug"),
+    (INFO, "Info"),
+    (WARNING, "Avertissement"),
+    (ERROR, "Erreur"),
+)
+DEFAULT_LEVELS = frozenset({INFO, WARNING, ERROR})
+LEVEL_COLORS = {DEBUG: "#6c7480", INFO: "#98a2b1", WARNING: "#f9c74f", ERROR: "#ff6b6b"}
+MAX_LINES = 2000
+
+
+def network_log_level(message: str) -> str:
+    """Level of a line of the server log, which carries none of its own."""
+    text = str(message).casefold()
+    if any(word in text for word in ("error", "erreur", "failed", "unavailable", "refused", "denied")):
+        return ERROR
+    if any(word in text for word in ("warning", "manual", "cgnat", "mismatch", "rate limit")):
+        return WARNING
+    if text.startswith(("[auth]", "[session]", "[server]", "[relay]", "[upnp]", "[firewall]")):
+        return INFO
+    return DEBUG
+
+
+@dataclass(frozen=True)
+class ChatLine:
+    level: str
+    sender: str
+    message: str
 
 
 class ChatPanel(QWidget):
+    """
+    Chat history plus one checkbox per log level (Debug, Info, Avertissement,
+    Erreur). Messages written by players or the GM are never hidden.
+
